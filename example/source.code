// macro definitions use $ for parameters to distinguish from idents in actual code.
// their syntax is similar to LaTeX commands.
def \foo($fn, $args) { $fn($args, 1) }

{ } } } // unbalanced brackets outside of a string are a visualized as an error, but won't be acknowledged until parsing

[ } ] ] // brackets balance visuals are dependent on matching delimiters

fn main() {
    // macro calls use braces for arguments, so that arguments can contain commas
    \foo{my_fn}{9, 3}

    for i in 0..5 {
        let ch = 'n';
        let ch = '\n';
        let float = 1.6343e24;
        let float1 = 1.6343e-24;
        const FOO_BAR = 3.1415;
        my'text = "this \"text\" is \x1b[91mred\x1b[0m";
        let my'text /* there is absolutely no reason for the apostrophe,
            /* i just /* wanted */ to /* show /* it */ off */ */ */ = "hello world";
            "aaaaa\x
              aaa" + 1 // multiline error
        print(my'text); // output the contents of `my'text` to the console
    }
}
